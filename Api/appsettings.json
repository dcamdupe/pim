{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Version": "1.0.0",
  "MongoSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "pim"
  },
  "JwtSettings": {
    "Issuer": "Pim.Api",
    "Audience": "Pim.Api",
    "SigningKey": "local-dev-signing-key-change-me-please-32chars-min",
    "ExpiryMinutes": 60
  }
}
