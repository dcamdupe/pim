<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- Console only - this app runs locally via Kestrel (console visible in
       the terminal) or in Lambda, where stdout is what CloudWatch Logs
       captures; there's no persistent filesystem to write a log file to. No ${longdate} - CloudWatch
       already timestamps every line on ingest. -->
  <targets>
    <!-- ignoreActivityId=true: since ASP.NET Core 3, aspnet-TraceIdentifier defaults to
         Activity.Current.Id (a W3C trace-parent id) instead of HttpContext.TraceIdentifier, which
         silently defeats Program.cs's override of TraceIdentifier with the Lambda AwsRequestId. -->
    <target xsi:type="Console"
            name="console"
            layout="${aspnet-TraceIdentifier:ignoreActivityId=true}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}" />
  </targets>

  <rules>
    <!-- Expected/harmless on Lambda - no persistent filesystem for Data Protection keys, and
         the app doesn't rely on Data Protection for anything persistent (JWT bearer auth, not
         cookies/antiforgery) - silence regardless of level, without hiding other framework
         warnings. -->
    <logger name="Microsoft.AspNetCore.DataProtection.*" final="true" />
    <!-- Keep ASP.NET Core's own framework logging quiet, matching
         appsettings.json's "Microsoft.AspNetCore": "Warning". -->
    <logger name="Microsoft.AspNetCore.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
