<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- Console only - this app runs locally via Kestrel (console visible in
       the terminal) or in Lambda, where stdout is what CloudWatch Logs
       captures; there's no persistent filesystem to write a log file to. -->
  <targets>
    <target xsi:type="Console"
            name="console"
            layout="${aspnet-TraceIdentifier}|${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}" />
  </targets>

  <rules>
    <!-- Keep ASP.NET Core's own framework logging quiet, matching
         appsettings.json's "Microsoft.AspNetCore": "Warning". -->
    <logger name="Microsoft.AspNetCore.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
