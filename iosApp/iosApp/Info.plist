<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- GENERATE_INFOPLIST_FILE is NO (custom Info.plist), so Xcode won't auto-inject these -
	     they have to be listed explicitly, using its usual $(VAR) build-setting substitution. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleDisplayName</key>
	<string>PIM</string>
	<!-- Shown in the Face ID permission prompt the first time the app unlocks a stored session
	     (UBE-105). Touch ID devices use the localizedReason passed to LAContext instead. -->
	<key>NSFaceIDUsageDescription</key>
	<string>PIM uses Face ID to unlock your saved session.</string>
	<!-- Must match AuthConfig.redirectUri's scheme - Cognito redirects here after Google sign-in
	     completes, and ASWebAuthenticationSession needs it registered to catch that redirect. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pim</string>
			</array>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
